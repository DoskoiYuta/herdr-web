{
  "name": "herdr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hw": "src/cli/hw.ts",
    "herdr-web": "src/server/main.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server/main.ts",
    "serve": "bun src/server/main.ts",
    "hw": "bun src/cli/hw.ts",
    "start": "NODE_ENV=production bun src/server/main.ts",
    "build": "bun run build:web && bun run build:bin",
    "build:web": "vite build && bun scripts/embed-web.ts",
    "build:bin": "bun build --compile --external vite --define process.env.NODE_ENV='\"production\"' src/server/main.ts --outfile dist/herdr-web && bun build --compile src/cli/hw.ts --outfile dist/hw",
    "test": "bun run test:server && bun run test:web",
    "test:server": "bun test src/server src/contract src/cli",
    "test:web": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "oxlint && dependency-cruiser --config .dependency-cruiser.cjs src",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "db:generate": "drizzle-kit generate && bun scripts/embed-migrations.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/valibot-validator": "^0.6.1",
    "@pierre/diffs": "^1.3.6",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-virtual": "^3.14.10",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@valibot/to-json-schema": "^1.7.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bun-pty": "^0.4.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.39.0",
    "mermaid": "^11.17.2",
    "neverthrow": "^8.2.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.9.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/bun": "latest",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8",
    "@vitejs/plugin-react": "^6.1.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
